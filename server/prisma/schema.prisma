// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  phoneNumber       String?
  age               Int?
  gender            String?
  country           String?
  knoccPrice        Float     @default(1.0)
  verified          Boolean   @default(false)
  walletBalance     Float     @default(0.0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // User Intelligence Data
  trustScore        Float?    @default(0)
  riskLevel         String?   @default("UNKNOWN")
  interests         String?   // JSON array of interests
  socialPresence    Boolean   @default(false)

  // User's settings
  autoApprove       Boolean   @default(false)
  requireReason     Boolean   @default(true)
  // Chat expiry: null = never expires, otherwise months of inactivity before re-Knocc required
  chatExpiryMonths  Int?

  // Inbound fee: cost for an external (non-Pryro) user to send an email to this user.
  // 0 = free (email delivered immediately). > 0 = sender must pay before email is revealed.
  inboundFee        Float     @default(0.0)
  isAdmin           Boolean   @default(false)

  // Encrypted SMTP password — used to send outbound email as this user
  smtpPassword      String?

  // Gmail AI learning
  gmailAccessEnabled Boolean  @default(false)
  gmailRefreshToken  String?  // Encrypted refresh token for offline access
  gmailLearnedTopics String?  // JSON array of topics learned from sent mail
  gmailLastSynced    DateTime?

  // Relationships
  sentEmails        Email[]   @relation("SentEmails")
  receivedEmails    EmailRecipient[]
  sentRequests      KnoccRequest[] @relation("SentRequests")
  receivedRequests  KnoccRequest[] @relation("ReceivedRequests")
  
  approvedContactsFrom  Contact[] @relation("ContactFrom")
  approvedContactsTo    Contact[] @relation("ContactTo")
  
  blockedUsers      BlockedUser[] @relation("Blocker")
  blockedByUsers    BlockedUser[] @relation("Blocked")
  
  transactions      Transaction[]
  sentInvitations   Invitation[] @relation("SentInvitations")

  // Per-user email flags
  emailStars        EmailStar[]
  emailDeletes      EmailDelete[]

  // Pay-to-reply invitations sent by this user to external addresses
  payToReplyInvitations  PayToReplyInvitation[]

  // Inbound requests received from external senders
  inboundRequests   InboundRequest[]

  // Password reset tokens
  passwordResetTokens    PasswordResetToken[]
  platformEarnings       PlatformEarning[]

  @@index([email])
}

model Email {
  id          String    @id @default(uuid())
  subject     String
  body        String
  senderId    String?
  sender      User?     @relation("SentEmails", fields: [senderId], references: [id], onDelete: Cascade)

  // External sender info — populated when a non-Pmail user replies via pay-to-reply
  externalSenderEmail String?
  externalSenderName  String?

  // Pay-to-reply settings (set by sender when composing to external addresses)
  payToReplyEnabled Boolean @default(false)
  replyFee          Float   @default(0)

  recipients  EmailRecipient[]
  attachments Attachment[]

  // Per-user flags (replaces global isStarred / isBin)
  stars       EmailStar[]
  deletes     EmailDelete[]

  // Pay-to-reply invitations for emails sent to external addresses
  payToReplyInvitations PayToReplyInvitation[]

  // If this email was created when a Pryro user accepted an inbound request
  inboundRequest  InboundRequest? @relation("InboundEmail")

  // Draft support
  isDraft     Boolean   @default(false)

  sentAt      DateTime  @default(now())
  // Keep for backward compat — no longer used for per-user logic
  isStarred   Boolean   @default(false)
  isArchived  Boolean   @default(false)
  isBin       Boolean   @default(false)

  @@index([senderId])
  @@index([sentAt])
  @@index([isDraft])
}

// ─── Inbound email from an external (non-Pryro) sender ──────────────────────
// When a non-Pryro user sends an email to a Pryro user via the inbound webhook
// or SMTP gateway, an InboundRequest is created.
//
// Flow:
//   PENDING  → external sender receives a "pay to view" notification email with a link
//   PAID     → Pryro recipient can now read the email body; must Accept or Decline
//   ACCEPTED → Pryro user accepted the message; they can reply via ComposeModal
//   DECLINED → Pryro user declined; external sender optionally notified
//   EXPIRED  → no payment / no action within the expiry window
model InboundRequest {
  id              String    @id @default(uuid())

  // The Pryro user this email was addressed to
  recipientId     String
  recipient       User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  // External sender details
  externalEmail   String
  externalName    String    @default("")

  // The email content (stored raw so it can be revealed after payment)
  subject         String
  body            String    @default("")

  // Fee charged to the external sender (0 = free — delivered immediately)
  inboundFee      Float     @default(0)

  // Unique token that secures the external payment/view page
  payToken        String    @unique

  // Lifecycle
  status          String    @default("PENDING") // PENDING | PAID | ACCEPTED | DECLINED | EXPIRED

  paidAt          DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  createdAt       DateTime  @default(now())

  // If the Pryro user accepts, an Email record is created so the message appears in inbox
  emailId         String?   @unique
  email           Email?    @relation("InboundEmail", fields: [emailId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([payToken])
  @@index([status])
  @@index([externalEmail])
}

// Pay-to-reply invitation — tracks an email sent to an external address
// where the recipient must pay a fee before they can reply.
model PayToReplyInvitation {
  id            String    @id @default(uuid())
  emailId       String
  email         Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  externalEmail String
  replyFee      Float
  status        String    @default("PENDING") // PENDING, PAID, REPLIED, EXPIRED
  replyToken    String    @unique
  paidAt        DateTime?
  repliedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([senderId])
  @@index([emailId])
  @@index([replyToken])
  @@index([status])
}

// Per-user star flag
model EmailStar {
  id        String   @id @default(uuid())
  emailId   String
  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  starredAt DateTime @default(now())

  @@unique([emailId, userId])
  @@index([userId])
}

// Per-user soft-delete flag
model EmailDelete {
  id        String   @id @default(uuid())
  emailId   String
  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedAt DateTime @default(now())

  @@unique([emailId, userId])
  @@index([userId])
}

model Attachment {
  id        String   @id @default(uuid())
  emailId   String
  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  size      Int
  data      String   // base64 encoded

  @@index([emailId])
}

model EmailRecipient {
  id          String    @id @default(uuid())
  emailId     String
  email       Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)
  
  recipientId String
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  
  type        String // TO, CC, BCC
  isRead      Boolean   @default(false)
  readAt      DateTime?

  @@index([emailId])
  @@index([recipientId])
}

model KnoccRequest {
  id            String    @id @default(uuid())
  senderId      String
  sender        User      @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  
  recipientId   String
  recipient     User      @relation("ReceivedRequests", fields: [recipientId], references: [id], onDelete: Cascade)
  
  reason        String
  message       String?
  paymentAmount Float
  paymentType   String // PAID, PRYRO
  
  status        String @default("PENDING") // PENDING, APPROVED, DECLINED
  
  createdAt     DateTime  @default(now())
  respondedAt   DateTime?

  @@index([senderId])
  @@index([recipientId])
  @@index([status])
}

model Contact {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation("ContactFrom", fields: [userId], references: [id], onDelete: Cascade)
  
  contactId   String
  contact     User      @relation("ContactTo", fields: [contactId], references: [id], onDelete: Cascade)
  
  approvedAt  DateTime  @default(now())
  // Updated whenever either side sends an email to the other
  lastEmailAt DateTime?

  @@unique([userId, contactId])
  @@index([userId])
  @@index([contactId])
}

model BlockedUser {
  id          String    @id @default(uuid())
  blockerId   String
  blocker     User      @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  
  blockedId   String
  blocked     User      @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  
  blockedAt   DateTime  @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Transaction {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        String // DEPOSIT, DEPOSIT_PENDING, KNOCC_SENT, KNOCC_RECEIVED, REFUND, WITHDRAWAL
  amount      Float
  description String
  
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Platform fee earned on every deposit — admin revenue tracking
model PlatformEarning {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feeAmount     Float
  depositAmount Float
  source        String   // MOMO, STRIPE, LIGHTNING
  referenceId   String
  createdAt     DateTime @default(now())

  @@index([source])
  @@index([createdAt])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Invitation {
  id          String    @id @default(uuid())
  senderId    String
  sender      User      @relation("SentInvitations", fields: [senderId], references: [id], onDelete: Cascade)
  
  email       String
  name        String?
  status      String @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  inviteCode  String    @unique
  
  sentAt      DateTime  @default(now())
  acceptedAt  DateTime?
  
  @@index([senderId])
  @@index([email])
  @@index([inviteCode])
  @@index([status])
}

// ─── Platform-wide admin settings ──────────────────────────────────────────
// Singleton row (id = "global"). Admin can toggle which payment gateway is live.
model PlatformSettings {
  id                String  @id @default("global")
  activeGateway     String  @default("MOMO") // MOMO | STRIPE | LIGHTNING
  updatedAt         DateTime @updatedAt
}

// ─── Human Entropy / Bot Detection ──────────────────────────────────────────
// Stores the result of invisible behavioral analysis performed during signup.
// verdict: HUMAN | UNCERTAIN | BOT
// shadowBanned: true means the account was silently created but cannot send email.
model SuspiciousActivity {
  id            String   @id @default(uuid())
  ip            String
  userAgent     String   @default("")
  score         Int
  flags         String   @default("") // comma-separated flag names
  verdict       String   // HUMAN | UNCERTAIN | BOT
  // Admin can manually correct the verdict after reviewing rawFeatures.
  // null = not yet reviewed, "HUMAN" / "BOT" = confirmed label.
  manualLabel   String?
  shadowBanned  Boolean  @default(false)
  username      String   @default("")
  // Full feature object as JSON — used for threshold tuning and auditing
  rawFeatures   String   @default("{}")
  createdAt     DateTime @default(now())

  @@index([ip])
  @@index([verdict])
  @@index([createdAt])
  @@index([manualLabel])
}
